      {
        "key": "field_td_tab_contenido",
        "label": "Contenido",
        "name": "",
        "type": "tab",
        "placement": "left"
      },
      {
        "key": "field_td_titulo",
        "label": "Título",
        "name": "titulo",
        "type": "text",
        "wrapper": {
          "width": "100"
        }
      },
      {
        "key": "field_td_subtitulo",
        "label": "Subtítulo",
        "name": "subtitulo",
        "type": "text",
        "wrapper": {
          "width": "100"
        }
      },
      {
        "key": "field_td_descripcion",
        "label": "Descripción",
        "name": "descripcion",
