      {
        "key": "field_td_tab_datos",
        "label": "Datos",
        "name": "",
        "type": "tab",
        "placement": "left"
      },
      {
        "key": "field_td_origen_datos",
        "label": "Origen de datos",
        "name": "origen_datos",
        "type": "radio",
        "choices": {
          "manual": "Manual",
          "csv": "CSV",
          "xlsx": "Excel (.xlsx)"
        },
        "default_value": "manual",
        "layout": "horizontal",
        "return_format": "value",
        "wrapper": {
          "width": "100"
        }
      },
      {
        "key": "field_td_archivo_dataset",
        "label": "Archivo de datos",
        "name": "archivo_dataset",
        "type": "file",
        "instructions": "Subí un CSV o XLSX. En CSV se detecta automáticamente si usa coma o punto y coma.",
        "required": 0,
        "conditional_logic": [
          [
            {
              "field": "field_td_origen_datos",
              "operator": "!=",
              "value": "manual"
            }
          ]
        ],
        "return_format": "array",
        "library": "all",
        "mime_types": "csv,xlsx",
        "wrapper": {
          "width": "50"
        }
      },
      {
        "key": "field_td_primera_fila_encabezados",
        "label": "Primera fila contiene encabezados",
        "name": "primera_fila_encabezados",
        "type": "true_false",
        "conditional_logic": [
          [
            {
              "field": "field_td_origen_datos",
              "operator": "!=",
              "value": "manual"
            }
          ]
        ],
        "default_value": 1,
        "ui": 1,
        "wrapper": {
          "width": "25"
        }
      },
      {
        "key": "field_td_hoja_excel",
        "label": "Hoja Excel",
        "name": "hoja_excel",
        "type": "number",
        "instructions": "Número de hoja. Por defecto 1.",
        "conditional_logic": [
          [
            {
              "field": "field_td_origen_datos",
              "operator": "==",
              "value": "xlsx"
            }
          ]
        ],
        "default_value": 1,
        "min": 1,
        "step": 1,
        "wrapper": {
          "width": "25"
        }
      },
      {
        "key": "field_td_tab_columnas",
        "label": "Columnas",
        "name": "",
        "type": "tab",
        "placement": "left"
      },
